graph TD
    %% style helpers
    classDef ui fill:#e8f5e9,stroke:#43a047,stroke-width:1;
    classDef svc fill:#e3f2fd,stroke:#1e88e5,stroke-width:1;
    classDef data fill:#fff3e0,stroke:#fb8c00,stroke-width:1;
    classDef infra fill:#f3e5f5,stroke:#8e24aa,stroke-width:1;

    %% nodes
    React["React JS UI"]:::ui
    Ingress["OpenShift<br/>Route / Ingress"]:::infra
    CoreSvc["Service: rasa-core"]:::svc
    CorePods["Rasa Core Pods<br/>(16 bots × 2 replicas)"]:::svc
    ActionPods["Rasa Action Pods<br/>(16 bots × 2 replicas)"]:::svc
    Mongo["MongoDB Tracker Store"]:::data
    Kafka["Kafka (monitoring)"]:::infra

    %% edges
    React -- "Socket.IO (WebSocket)" --> Ingress
    Ingress --> CoreSvc
    CoreSvc --> CorePods
    CorePods -- "HTTP / JSON" --> ActionPods
    CorePods -- "tracker events" --> Mongo
    CorePods -- "metrics / logs" --> Kafka



flowchart TD
    classDef pod fill:#e3f2fd,stroke:#1e88e5,stroke-width:1;
    classDef store fill:#fff3e0,stroke:#fb8c00,stroke-width:1;
    classDef infra fill:#f3e5f5,stroke:#8e24aa,stroke-width:1;

    subgraph "OpenShift Project / Namespace : chatbot"
